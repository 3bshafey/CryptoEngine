      <pointsize>14</pointsize>
     </font>
    </property>
    <property name="styleSheet">
     <string notr="true">QRadioButton#radioButton {
    color: white;
    padding: 10px;
}

QRadioButton#radioButton::indicator {
    border: 2px solid rgba(30, 123, 111, 255); /* Outer border color – bluish green */
    border-radius: 10px;
    width: 20px;
    height: 20px;
    background-color: rgba(60, 150, 220, 255); /* Base color – light blue */
}

QRadioButton#radioButton::indicator:checked {
    background-color: rgba(25, 115, 105, 255); /* When checked – greenish blue */
    border: 2px solid rgba(50, 135, 210, 255); /* Border color when checked */
}

QRadioButton#radioButton::indicator:hover {
    background-color: rgba(50, 135, 210, 255); /* Light blue on hover */
    border: 2px solid rgba(30, 123, 111, 255); /* Border color on hover */
}
</string>
    </property>
