   <widget class="QLineEdit" name="lineEdit_2">
    <property name="geometry">
     <rect>
      <x>240</x>
      <y>200</y>
      <width>271</width>
      <height>40</height>
     </rect>
    </property>
    <property name="font">
     <font>
      <family>Segoe UI</family>
      <pointsize>-1</pointsize>
     </font>
    </property>
    <property name="styleSheet">
     <string notr="true">#lineEdit_2 {
    background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 123, 111, 0.5), /* أخضر مزرق مع شفافية */
        stop:1 rgba(60, 150, 220, 0.5)  /* أزرق مع شفافية */
    );
    border: none;
    border-bottom: 2px solid rgba(30, 123, 111, 0.7); /* حد سفلي بلون أخضر مع شفافية */
    color: white; /* تغيير لون النص إلى الأبيض */
    padding-bottom: 7px; /* المسافة الداخلية السفلية */
    font-size: 16px; /* حجم الخط */
    border-radius: 5px; /* حواف دائرية خفيفة */
}

#lineEdit_2:focus {
    background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(30, 123, 111, 0.7), /* أخضر مزرق مع شفافية عند التركيز */
        stop:1 rgba(60, 150, 220, 0.7)  /* أزرق مع شفافية عند التركيز */
    );
    border-bottom: 2px solid rgba(30, 123, 111, 1); /* حد سفلي أخضر عند التركيز */
    outline: none; /* إزالة الخط المحيط عند التركيز */
}

#lineEdit_2:hover {
    border-bottom: 2px solid rgba(30, 123, 111, 1); /* تفاعل عند المرور بالماوس */
}

#lineEdit_2:disabled {
    background-color: rgba(240, 240, 240, 0.6); /* خلفية باهتة عند تعطيل الحقل */
    color: rgba(128, 128, 128, 0.6); /* لون النص عند تعطيل الحقل */
    border-bottom: 2px solid rgba(200, 200, 200, 0.6); /* حدود باهتة عند تعطيل الحقل */
}
</string>
    </property>
    <property name="text">
     <string/>
    </property>
    <property name="echoMode">
